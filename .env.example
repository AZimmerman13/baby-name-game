# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./data/baby_name_game.db
ADMIN_SECRET_KEY=your-secure-random-key-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=your-secure-random-key-generate-with-openssl-rand-hex-32
COOKIE_SECURE=True

# CORS (Production)
CORS_ORIGINS=https://storkpool.com,https://www.storkpool.com

# Frontend Configuration
REACT_APP_API_URL=/api

# Production Domain
DOMAIN=storkpool.com
EMAIL=auszim@gmail.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FRONTEND_URL=https://storkpool.com

# IMPORTANT SECURITY NOTES:
# 1. Generate secure random keys with: openssl rand -hex 32
# 2. Never commit your actual .env file with real secrets to git
# 3. Set COOKIE_SECURE=True for production (requires HTTPS)
# 4. Set COOKIE_SECURE=False for local development only
